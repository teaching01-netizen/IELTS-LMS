# Required
REGISTER_URL=https://ielts-warwick-institute.up.railway.app/student/<schedule-id>/register
USERS_FILE=/workspace/e2e/prod-load/live-users.500.csv
USER_COUNT=60

# Sharding (set one slice per instance)
USER_OFFSET=0

# Browser mode
HEADLESS=true
HEADED_USERS=0
MAX_CONCURRENT_USERS=10

# Dashboard and capture
DASHBOARD_PORT=3360
LIVE_MODE=balanced
SCREENSHOT_INTERVAL_MS=1000
JPEG_QUALITY=45

# Timeouts
NAV_TIMEOUT_MS=120000
START_POLL_INTERVAL_MS=2500
START_TIMEOUT_MS=1200000
EXAM_TIMEOUT_MS=1800000

# Output/logs
OUTPUT_DIR=e2e/.generated/live-runner
LIVE_RUN_LOG_FILE=
DELETE_ARTIFACTS_ON_FINISH=false

# UI server (bun run e2e:leapcell-ui)
LEAPCELL_LOAD_UI_PORT=3366
HOST=0.0.0.0

# Optional k6 integration
RUN_WITH_K6=false
K6_CONFIRM_PROD=true
K6_SCRIPT=k6/prod-start-exam-200.js
K6_STUDENTS=60
K6_LOG_FILE=
