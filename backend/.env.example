# Go backend development environment. Copy to backend/.env and adjust the
# database/object-storage values for your machine.
API_HOST=0.0.0.0
API_PORT=4000
# Railway and other managed platforms inject PORT; local development uses
# API_PORT when PORT is absent.
PORT=4000
ENVIRONMENT=development
RESOURCE_PROFILE=

# Native go-sql-driver/mysql DSN (use mysql://... only when the deployment
# platform injects a URI; the Go connection boundary normalizes both forms).
DATABASE_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DATABASE_DIRECT_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DATABASE_MIGRATOR_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DATABASE_WORKER_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DB_POOL_MIN_CONNECTIONS=0
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MAX_IDLE=5
DB_POOL_ACQUIRE_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_SECS=60

BACKGROUND_RUNTIME_MODE=continuous
IDLE_GRACE_SECS=300
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_FALLBACK_INTERVAL_SECS=5
WORKER_MAINTENANCE_INTERVAL_SECS=300
LIVE_UPDATE_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
AUTO_SUBMIT_BATCH_SIZE=100

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=ielts-media
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_LOCAL_ROOT=./.data/object-store
MEDIA_BASE_URL=https://media.local.invalid

LIVE_MODE_ENABLED=true
GRADING_PROJECTION_ENABLED=true
GRADING_SYNC_ON_READ_FALLBACK=false
PROMETHEUS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Use a local-only secret with at least 32 characters.
AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf
COOKIE_SECURE=false
SESSION_IDLE_STAFF_MINS=30
SESSION_IDLE_STUDENT_MINS=60
SESSION_ABSOLUTE_HOURS=12
ATTEMPT_TOKEN_TTL_MINUTES=15

MAX_MUTATIONS_PER_BATCH=200
MAX_WRITING_ANSWER_CHARS=50000
MAX_TEXT_ANSWER_CHARS=512
HEARTBEAT_PRESENCE_MIN_WRITE_INTERVAL_SECS=5

RATE_LIMIT_GLOBAL=600
RATE_LIMIT_BUCKET_CAP=120
# Per-tier per-minute budgets (optional; defaults shown). Each tier gets an
# independent quota keyed by user/attempt identity (authenticated) or IP
# (anonymous), so bulk polling can no longer starve auth session reads.
# RATE_LIMIT_AUTH_CRITICAL_PER_MIN=120
# RATE_LIMIT_ANON_AUTH_PER_MIN=30
# RATE_LIMIT_AUTHED_READS_PER_MIN=300
# RATE_LIMIT_POLLING_PER_MIN=240
# RATE_LIMIT_HEARTBEAT_PER_MIN=120
# RATE_LIMIT_WRITES_PER_MIN=120
# RATE_LIMIT_BACKSTOP_PER_MIN=3000
# A1 single-deploy posture (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# dual = local prefilter + DB verdict (ship default, behavior-preserving);
# local = local-only, zero per-request DB verdicts (single process IS global).
# Unknown values fail closed at startup validation.
# RATE_LIMIT_MODE=dual
# A2 session cache (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# off = today's SELECT + UPDATE touch per lookup (ship default);
# on = LRU hits serve with zero SQL, touch UPDATEs coalesce to ~1 per
# SESSION_TOUCH_COALESCE_SECS per session. Rollback = off.
# SESSION_CACHE=off
# SESSION_CACHE_MAX=150000
# SESSION_TOUCH_COALESCE_SECS=300
# A3 attempt-bearer verify (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# strict = HMAC + expiry + attempt_sessions DB binding (ship default);
# stateless = HMAC + expiry only, zero SQL (binding enforced against the
# locked attempt row in-tx + URL params at the edge; revocation via 15m TTL
# + lease-epoch fencing). Unknown values fail closed at startup. Rollback =
# strict.
# ATTEMPT_VERIFY=strict
# B2 runtime snapshot pre-gate (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# off = today's FOR UPDATE runtime+section locks on every V2 write (ship default);
# on = ~1s-TTL committed-read snapshot pre-gate (zero SQL on fresh+live hits,
# one sync refresh+retry on stale, then today's 422/409). Control commands
# (pause/resume/extend/complete) invalidate post-commit. Rollback = off.
# RUNTIME_SNAPSHOT=off
# B3 row-first writes (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# off = today's mergeProjection (full-blob rewrite per answer, ship default);
# on = rows-only UPSERT per cell + narrow revision UPDATE; blobs become read
# views (lazy on V1 reads, worker flush 50/cycle, synchronous at seal).
# ROLLBACK: off. METRIC: student_attempts UPDATE bytes (drop 10-100x).
# ROW_FIRST_WRITES=off
# B4 outbox + pools (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# OUTBOX_EXEC_ONLY=off (default): wakeup families enqueue for worker relay.
# on = skip wakeup INSERTs (attempt_terminalized/runtime_changed/roster_changed);
# only auto_submit_schedule_attempts_requested enqueues. ROLLBACK: off.
# OUTBOX_EXEC_ONLY=off
# Pool split from one DSN (unset = DB_POOL_MAX_CONNECTIONS on both sides):
# DB_POOL_MAX_API=40 / DB_POOL_MAX_WORKER=10. ROLLBACK: unset.
# Partitioned claiming: WORKER_CLAIM_PARTITIONS=4 selects N in-process
# consumers with disjoint MOD(CRC32(aggregate_id)) leases + smaller batches.
# OUTBOX_CLAIM_MODE=update (default) | skiplocked (SELECT ... FOR UPDATE
# SKIP LOCKED + UPDATE by id). ROLLBACK: 1 + update.
# C1 live bus (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# LIVE_BUS=db (default): AppendInTx INSERT in-tx + forwarder poll.
# LIVE_BUS=direct: Hub-only post-commit, zero live SQL (single-deploy: no
# peers). REQUIRES OUTBOX_EXEC_ONLY=on (validator enforces; wakeup rows
# would otherwise be dropped). ROLLBACK: db.
# LIVE_BUS_SINK=off (default): no live_update_events writes at all.
# sample = ~1:1000 async debug rows post-commit (retention still purges).
# C2 WS admission (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# WS_ADMISSION=db (default): singleton-row lease tx per connect.
# memory = in-process gate, zero SQL (caps WS_CAP_TOTAL=30000 /
# WS_CAP_USER=5 / WS_CAP_SCHEDULE=20000; non-positive clamps to defaults).
# Restart clears memory admission (safe: briefly permissive). ROLLBACK: db.
# C3 runtime poll (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# GET /api/v1/student/sessions/{scheduleID}/runtime?sinceRevision=N (Polling
# tier, session or attempt-bearer): 304 when current, else
# {revision,status,activeSection,pollAfterSecs} (2s fast-lane 60s after
# control commands, 25s steady). STUDENT_WS=allow (default, dual-serve) |
# gone (student WS -> 410 + {use: runtime-poll}; staff WS kept).
# Visibility bound: control effects land within pollAfterSecs; write gates
# enforce regardless of poll lag. ROLLBACK: allow.
# D2 presence (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# PRESENCE_MODE=inline (default, per-beat tx) | memory = PresenceMap touch
# (zero heartbeat-event SQL steady-state; projection re-read only) + worker
# flush of status transitions (60s cadence, integrity UPDATE only on
# disconnect/lost/reconnect transitions). LIMITATION (single-deploy): api +
# worker are separate processes, so the worker drain only covers same-process
# embeddings — memory is exam-day-only until the flush moves into the API
# process. 60s DB staleness for presence analytics; proctor view is
# memory-fresh. ROLLBACK: inline.
# D3 entry gate + provisioning (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# ENTRY_GATE=off (default, today's shape) | on = in-memory per-schedule token
# bucket BEFORE user lookup; over-limit -> 429 CodeRateLimitExceeded +
# {tier: student-entry, retryAfterSecs, queuePosition} + Retry-After header.
# ENTRY_PER_SEC_PER_SCHEDULE=500 sustained, ENTRY_BURST=2000 absorbency
# (non-positive clamps to defaults). Pre-provision: go run ./cmd/preprovision
# -schedule <id> -registrations <regID,...> mints attempts ahead of exam day
# (idempotent; entry degrades to token+session). ROLLBACK: off.
# E2 load shedding (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# SHED_MODE=off (default, ship budgets) | exam = rebalance toward
# submit/seal/autosave (writes NEVER shed) at the expense of runtime-poll
# (240->60), heartbeat (120->30), authed-reads/admin (300->150). Proctor
# roster endpoints live under authed-reads; entry gate tightens separately
# via ENTRY_PER_SEC_PER_SCHEDULE. Frozen-deploys + migration-freeze around
# exams stay ops policy. ROLLBACK: off.
# D4 roster rollup (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# ROLLUP=off (default, full roster) | on = worker GROUP BY per live schedule
# into shared_cache_entries (no migration); dashboard header polls
# GET /proctor/sessions/{id}?mode=rollup (miss falls back to full detail),
# roster pages via GET /proctor/sessions/{id}/roster
# (?cursorUpdatedAt+cursorID, ?limit<=1000, ?status). Staleness bounded by
# worker cadence, displayed as updatedAgoSecs. ROLLBACK: off.
# D1 version cache (plan docs/architecture/single-deploy-mysql-scale-plan.md):
# VERSION_CACHE=off (default): N+1 LoadSections per bootstrap.
# on = shared LRU(50) of assembled trees, revision-probed (fail-closed on
# publish races), singleflight on miss; ETag W/"v{versionID}-{rev}" +
# If-None-Match -> 304 on bootstrap/static. ROLLBACK: off.
STORM_ADMISSION_ENABLED=false

# Disabled by default in development; enable only with a password.
MASTER_KEY_ENABLED=false
MASTER_KEY_USERNAME=master
MASTER_KEY_PASSWORD=

# The Vite app reads these values when the backend feature path is enabled.
FEATURE_USE_BACKEND_BUILDER=true
FEATURE_USE_BACKEND_SCHEDULING=true
FEATURE_USE_BACKEND_DELIVERY=true
FEATURE_USE_BACKEND_PROCTORING=true
FEATURE_USE_BACKEND_GRADING=true
