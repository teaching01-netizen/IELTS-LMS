# Go backend development environment. Copy to backend/.env and adjust the
# database/object-storage values for your machine.
API_HOST=0.0.0.0
API_PORT=4000
# Railway and other managed platforms inject PORT; local development uses
# API_PORT when PORT is absent.
PORT=4000
ENVIRONMENT=development
RESOURCE_PROFILE=

# Native go-sql-driver/mysql DSN (use mysql://... only when the deployment
# platform injects a URI; the Go connection boundary normalizes both forms).
DATABASE_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DATABASE_DIRECT_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DATABASE_MIGRATOR_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DATABASE_WORKER_URL="root:root@tcp(127.0.0.1:3306)/ielts?parseTime=true&multiStatements=true&charset=utf8mb4"
DB_POOL_MIN_CONNECTIONS=0
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MAX_IDLE=5
DB_POOL_ACQUIRE_TIMEOUT_MS=3000
DB_POOL_IDLE_TIMEOUT_SECS=60

BACKGROUND_RUNTIME_MODE=continuous
IDLE_GRACE_SECS=300
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_FALLBACK_INTERVAL_SECS=5
WORKER_MAINTENANCE_INTERVAL_SECS=300
LIVE_UPDATE_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
AUTO_SUBMIT_BATCH_SIZE=100

OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=ielts-media
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_LOCAL_ROOT=./.data/object-store
MEDIA_BASE_URL=https://media.local.invalid

LIVE_MODE_ENABLED=true
GRADING_PROJECTION_ENABLED=true
GRADING_SYNC_ON_READ_FALLBACK=false
PROMETHEUS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Use a local-only secret with at least 32 characters.
AUTH_SECRET=replace-with-a-local-secret-at-least-32-characters
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf
COOKIE_SECURE=false
SESSION_IDLE_STAFF_MINS=30
SESSION_IDLE_STUDENT_MINS=60
SESSION_ABSOLUTE_HOURS=12
ATTEMPT_TOKEN_TTL_MINUTES=15

MAX_MUTATIONS_PER_BATCH=200
MAX_WRITING_ANSWER_CHARS=50000
MAX_TEXT_ANSWER_CHARS=512
HEARTBEAT_PRESENCE_MIN_WRITE_INTERVAL_SECS=5

RATE_LIMIT_GLOBAL=600
RATE_LIMIT_BUCKET_CAP=120
STORM_ADMISSION_ENABLED=false

# Disabled by default in development; enable only with a password.
MASTER_KEY_ENABLED=false
MASTER_KEY_USERNAME=master
MASTER_KEY_PASSWORD=

# The Vite app reads these values when the backend feature path is enabled.
FEATURE_USE_BACKEND_BUILDER=true
FEATURE_USE_BACKEND_SCHEDULING=true
FEATURE_USE_BACKEND_DELIVERY=true
FEATURE_USE_BACKEND_PROCTORING=true
FEATURE_USE_BACKEND_GRADING=true
