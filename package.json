{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "playwright": "playwright test",
    "playwright:ui": "playwright test --ui",
    "playwright:debug": "playwright test --debug",
    "e2e:prod-smoke": "playwright test --config playwright.prod-smoke.config.ts",
    "e2e:prod-load": "playwright test --config playwright.prod-load.config.ts",
    "e2e:live-runner": "tsx e2e/prod-load/live-multi-user-runner.ts",
    "test:live-runner": "vitest run --config vitest.prod-load.config.ts",
    "k6:exam-day": "k6 run k6/prod-exam-day.js",
    "k6:start-exam": "k6 run k6/prod-start-exam-200.js",
    "k6:section-transition": "k6 run k6/prod-section-transition-200.js",
    "k6:submit-storm": "k6 run k6/prod-submit-storm-200.js",
    "k6:resume": "k6 run k6/prod-resume-100.js",
    "k6:auto-submit": "k6 run k6/prod-auto-submit-200.js",
    "e2e:live-with-k6": "sh -c 'TS=$(date +%s); LOG_DIR=\"${LOG_DIR:-e2e/.generated/live-runner}\"; mkdir -p \"$LOG_DIR\"; K6_LOG_FILE=\"${K6_LOG_FILE:-$LOG_DIR/k6-$TS.log}\"; LIVE_RUN_LOG_FILE=\"${LIVE_RUN_LOG_FILE:-$LOG_DIR/live-runner-$TS.log}\"; echo \"[combo] k6 log: $K6_LOG_FILE\"; echo \"[combo] live log: $LIVE_RUN_LOG_FILE\"; k6 run \"${K6_SCRIPT:-k6/prod-start-exam-200.js}\" > \"$K6_LOG_FILE\" 2>&1 & K6_PID=$!; LIVE_RUN_LOG_FILE=\"$LIVE_RUN_LOG_FILE\" npm run e2e:live-runner; STATUS=$?; kill $K6_PID >/dev/null 2>&1 || true; wait $K6_PID >/dev/null 2>&1 || true; exit $STATUS'",
    "e2e:leapcell-ui": "node deploy/leapcell-load/ui-server.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.99.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.1",
    "react-virtuoso": "^4.18.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-onboarding": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0",
    "vitest": "^2.0.0"
  }
}
