# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend runtime environment. The production image sets this to production.
ENVIRONMENT="development"

# Development only: Vite dev-server proxy target for backend API requests.
VITE_BACKEND_API_URL="http://127.0.0.1:4000"

# Production testing: API base URL for Railway deployment
# Set automatically in CI/CD during Railway deployment
VITE_API_BASE_URL="https://your-railway-app.railway.app"

# SAT authoring realtime (Phase 02): gates durable authoring event rows on
# the live-update bus. Off (default) = byte-identical legacy authoring with
# no bus INSERT. Rollout stage 1 turns this on in dark mode.
AUTHORING_REALTIME_EVENTS="false"

# SAT authoring realtime (Phase 03): gates the authoring WebSocket delivery
# endpoint (/authoring/ws). Off (default) = the socket route is not mounted and
# authors keep working over HTTP only.
AUTHORING_REALTIME_DELIVERY="false"

# SAT authoring realtime (Phase 05): gates the ephemeral presence relay on the
# authoring socket. Off (default) = presence frames are rejected as unsupported
# and no peer identity is ever exposed.
AUTHORING_REALTIME_PRESENCE="false"

# SAT authoring realtime (Phase 05): advertised to clients so they may run the
# local three-way divergence comparison. Purely advisory; never gates whether
# the server persists an author's revision (HTTP stays authoritative).
AUTHORING_REALTIME_CONFLICT_COMPARE="false"

# Frontend kill switches. These can only DISABLE a server-granted capability,
# never enable one the server withheld (effective = server AND kill switch).
VITE_AUTHORING_REALTIME_EVENTS="false"
VITE_AUTHORING_REALTIME_DELIVERY="false"
VITE_AUTHORING_PRESENCE="false"
VITE_AUTHORING_CONFLICT_COMPARE="false"

# Cache, RAM, and retention guardrails
# Use RESOURCE_PROFILE=low for tiny one-instance deployments around 1 CPU, 1 GiB RAM, and 5 GiB disk.
RESOURCE_PROFILE=""
# Railway Serverless: set to "activity_driven"; continuous is the rollback/default mode.
BACKGROUND_RUNTIME_MODE="continuous"
BACKGROUND_IDLE_GRACE_SECS="60"
BACKGROUND_COMMAND_QUEUE_CAP="256"
BACKGROUND_WAKE_TIMEOUT_MS="10000"
DB_POOL_IDLE_TIMEOUT_SECS="60"
# API-only low-memory tuning for glibc allocator (idle-RSS optimization)
API_MALLOC_ARENA_MAX="1"
API_MALLOC_TRIM_THRESHOLD="131072"
API_MALLOC_MMAP_THRESHOLD="131072"
# Keep API OTEL disabled unless intentionally configured
API_OTEL_EXPORTER_OTLP_ENDPOINT=""
RATE_LIMITER_BUCKET_CAP="10000"
RETENTION_CLEANUP_BATCH_LIMIT="1000"
RETENTION_SHARED_CACHE_GRACE_HOURS="24"
RETENTION_IDEMPOTENCY_USABLE_HOURS="72"
RETENTION_IDEMPOTENCY_GRACE_HOURS="24"
RETENTION_HEARTBEAT_DAYS="7"
RETENTION_MUTATION_DAYS="30"
RETENTION_USER_SESSION_DAYS="30"

# Desmos API v1.12 for Digital SAT Math calculator.
# Use desmos-hosted until the licensed partner self-host bundle is injected at build time.
VITE_DESMOS_MODE="desmos-hosted"
VITE_DESMOS_API_KEY=""
VITE_DESMOS_API_URL=""
# Recommended production exam mode after obtaining the official self-host distribution:
# VITE_DESMOS_MODE="self-hosted"
# DESMOS_SELF_HOST_SOURCE_DIR="vendor-private/desmos/v1.12"
# VITE_DESMOS_API_URL="/vendor/desmos/v1.12/calculator.js"
